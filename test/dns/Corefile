# DNS sidecar (test/compose.yaml's `dns` service, CoreDNS, pinned
# coredns/coredns:1.11.3) - authoritative for a.example/b.example so row 6's
# A -> B delivery and DKIM check go through a real MX/TXT lookup. See
# test/README.md "DNS sidecar" for the full mechanism.
#
# `reload` is declared but not relied on: it only watches db.example's own
# mtime, not the $INCLUDE'd generated/dkim.zone (verified empirically -
# rewriting just the included file did not pick up within several reload
# intervals). The dns_sidecar fixture in conftest.py restarts this
# container after writing generated/dkim.zone instead - reliable, and fast
# (CoreDNS has no state to rebuild).
example. {
    file /etc/coredns/db.example {
        reload 2s
    }
    log
    errors
}

# Row 9 (virus, ClamAV on by default): mail-a/mail-b use ONLY this sidecar
# as their resolver (test/compose.yaml's `dns:` field), and freshclam needs
# to resolve real internet hostnames (database.clamav.net and friends) to
# fetch the virus signature database on first start - without a catch-all
# forwarder, every non-"example." query got NXDOMAIN from this file
# plugin's implicit deny, so freshclam could never reach the internet
# and clamd never finished loading (confirmed: `docker exec ... freshclam`
# failed name resolution before this block existed). "." matches any name
# this server isn't itself authoritative for; CoreDNS tries the more
# specific "example." zone above first.
. {
    forward . 8.8.8.8 1.1.1.1
    log
    errors
}
